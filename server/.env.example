# Copy this file to .env and fill in your values
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

PORT=5001
NODE_ENV=development

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/auth-app

# JWT secrets — must be long, random, and DIFFERENT from each other
JWT_ACCESS_SECRET=replace_with_random_64_char_hex_string
JWT_REFRESH_SECRET=replace_with_another_random_64_char_hex_string

# Email — use https://ethereal.email for development (free fake SMTP)
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_USER=your_ethereal_user
EMAIL_PASS=your_ethereal_pass
EMAIL_FROM=noreply@authapp.dev
EMAIL_FROM_NAME=AuthApp

# Must match the React dev server URL (used in email links and CORS)
CLIENT_URL=http://localhost:3000
